{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://psd-inspector.example.com/schemas/design-ir-v1.json",
  "title": "Design IR Schema",
  "description": "Design Intermediate Representation schema for PSD analysis results",
  "version": "1.0.0",
  
  "type": "object",
  "required": ["schemaVersion", "document", "source"],
  
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Schema version following semantic versioning"
    },
    
    "document": {
      "type": "object",
      "required": ["metadata"],
      "properties": {
        "metadata": {
          "$ref": "#/definitions/DocumentMetadata"
        },
        "artboards": {
          "type": "array",
          "items": {"$ref": "#/definitions/Artboard"}
        },
        "coordinateSpaces": {
          "type": "array",
          "items": {"$ref": "#/definitions/CoordinateSpace"}
        }
      }
    },
    
    "source": {
      "type": "object",
      "required": ["rawLayers"],
      "properties": {
        "rawLayers": {
          "type": "array",
          "items": {"$ref": "#/definitions/Layer"}
        },
        "layerHierarchy": {
          "type": "array",
          "items": {"type": "object"}
        },
        "originalStyles": {
          "type": "array",
          "items": {"type": "object"}
        },
        "nativeReferences": {
          "type": "array",
          "items": {"type": "object"}
        }
      }
    },
    
    "analysis": {
      "type": "object",
      "properties": {
        "measurements": {
          "type": "array",
          "items": {"type": "object"}
        },
        "spatialRelationships": {
          "type": "array",
          "items": {"$ref": "#/definitions/SpatialRelationship"}
        },
        "layoutHypotheses": {
          "type": "array",
          "items": {"$ref": "#/definitions/LayoutHypothesis"}
        },
        "semanticComponents": {
          "type": "array",
          "items": {"$ref": "#/definitions/SemanticComponent"}
        }
      }
    },
    
    "designSystem": {
      "type": "object",
      "properties": {
        "colorTokens": {
          "type": "array",
          "items": {"$ref": "#/definitions/DesignToken"}
        },
        "typographyTokens": {
          "type": "array",
          "items": {"$ref": "#/definitions/DesignToken"}
        },
        "spacingTokens": {
          "type": "array",
          "items": {"$ref": "#/definitions/DesignToken"}
        },
        "componentPatterns": {
          "type": "array",
          "items": {"type": "object"}
        }
      }
    },
    
    "diagnostics": {
      "type": "object",
      "required": ["unsupportedFeatures", "warnings", "validationResults"],
      "properties": {
        "unsupportedFeatures": {
          "type": "array",
          "items": {"type": "string"}
        },
        "warnings": {
          "type": "array",
          "items": {"type": "string"}
        },
        "validationResults": {
          "type": "array",
          "items": {"type": "object"}
        }
      }
    }
  },
  
  "definitions": {
    "DocumentMetadata": {
      "type": "object",
      "required": ["filename", "parser_version", "width_px", "height_px", "total_layers"],
      "properties": {
        "filename": {"type": "string"},
        "file_size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "psd_version": {"type": "string"},
        "parser_version": {"type": "string"},
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "dpi_horizontal": {"type": "number", "minimum": 0},
        "dpi_vertical": {"type": "number", "minimum": 0},
        "color_mode": {"type": "string"},
        "bit_depth": {"type": "integer", "enum": [1, 8, 16, 32]},
        "total_layers": {"type": "integer", "minimum": 0},
        "total_groups": {"type": "integer", "minimum": 0}
      }
    },
    
    "Layer": {
      "type": "object",
      "required": ["id", "name", "kind", "geometry", "appearance"],
      "properties": {
        "id": {"type": "string"},
        "source_layer_id": {"type": ["integer", "null"]},
        "name": {"type": "string"},
        "kind": {"type": "string", "enum": ["pixel", "shape", "text", "group", "smart_object", "adjustment", "fill", "stroke"]},
        "parent_id": {"type": ["string", "null"]},
        "z_index": {"type": "integer"},
        "depth": {"type": "integer", "minimum": 0},
        "visible": {"type": "boolean"},
        "locked": {"type": "boolean"},
        "coordinate_space_id": {"type": "string"},
        "geometry": {"$ref": "#/definitions/Geometry"},
        "appearance": {"$ref": "#/definitions/Appearance"},
        "masks": {"type": "array", "items": {"type": "string"}},
        "vector_masks": {"type": "array", "items": {"type": "string"}},
        "clipping_groups": {"type": "array", "items": {"type": "string"}},
        "mask": {"type": ["object", "null"]},
        "vector_mask": {"type": ["object", "null"]},
        "smart_object_link": {"type": ["string", "null"]},
        "smart_object_data": {"type": ["object", "null"]},
        "extraction": {"$ref": "#/definitions/ExtractionInfo"}
      }
    },
    
    "Geometry": {
      "type": "object",
      "required": ["source_bounds", "visible_bounds"],
      "properties": {
        "source_bounds": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {"type": "integer"},
            "y": {"type": "integer"},
            "width": {"type": "integer", "minimum": 0},
            "height": {"type": "integer", "minimum": 0}
          }
        },
        "visible_bounds": {"type": "object"},
        "effect_bounds": {"type": ["object", "null"]},
        "normalized": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "width": {"type": "number", "minimum": 0},
            "height": {"type": "number", "minimum": 0}
          }
        },
        "rotation_deg": {"type": "number"},
        "transform_matrix": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 6,
          "maxItems": 6
        }
      }
    },
    
    "Appearance": {
      "type": "object",
      "properties": {
        "opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "fill_opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "blend_mode": {"type": "string"},
        "fills": {
          "type": "array",
          "items": {"type": "object"}
        },
        "strokes": {
          "type": "array",
          "items": {"type": "object"}
        },
        "border_radius": {"type": "object"},
        "drop_shadow": {"type": ["object", "null"]},
        "inner_shadow": {"type": ["object", "null"]}
      }
    },
    
    "SpatialRelationship": {
      "type": "object",
      "required": ["source_layer_id", "target_layer_id", "distance_px"],
      "properties": {
        "source_layer_id": {"type": "string"},
        "target_layer_id": {"type": "string"},
        "distance_px": {"type": "number", "minimum": 0},
        "is_neighbor": {"type": "boolean"},
        "relative_position": {"type": "string"}
      }
    },
    
    "LayoutHypothesis": {
      "type": "object",
      "required": ["id", "layers_involved"],
      "properties": {
        "id": {"type": "string"},
        "layout_type": {"type": "string", "enum": ["flex", "grid", "absolute"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "layers_involved": {"type": "array", "items": {"type": "string"}}
      }
    },
    
    "SemanticComponent": {
      "type": "object",
      "required": ["id", "kind", "source_layer_ids"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string", "enum": ["button", "input", "card", "navigation", "icon"]},
        "source_layer_ids": {"type": "array", "items": {"type": "string"}},
        "name": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    
    "DesignToken": {
      "type": "object",
      "required": ["id", "name", "type", "value"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "type": {"type": "string", "enum": ["color", "typography", "spacing", "border", "shadow", "size", "composition", "animation", "custom"]},
        "category": {"type": "string"},
        "value": {"type": "object"}
      }
    },
    
    "ExtractionInfo": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["complete", "partial", "failed", "unsupported"]},
        "source": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "errors": {"type": "array", "items": {"type": "string"}},
        "property_sources": {"type": "object"}
      }
    },
    
    "Artboard": {
      "type": "object",
      "required": ["id", "name", "index", "width_px", "height_px"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "index": {"type": "integer"},
        "x": {"type": "integer"},
        "y": {"type": "integer"},
        "width_px": {"type": "integer"},
        "height_px": {"type": "integer"}
      }
    },
    
    "CoordinateSpace": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string", "enum": ["document", "artboard", "group"]},
        "origin_x": {"type": "number"},
        "origin_y": {"type": "number"},
        "width_px": {"type": "number"}
      }
    }
  }
}
